# Names only — never commit real values. Config is validated at boot (docs/01 §2.1).

# --- API (Railway) ---
NODE_ENV=development
PORT=8080
MONGODB_URI=
JWT_SECRET=                 # >= 32 chars
JWT_EXPIRES_IN=15m
CORS_ORIGIN=               # the frontend origin, e.g. https://<user>.github.io

# Payments (docs/04 §0a). Access is per-course by price; these keys only gate
# whether paid courses can be PURCHASED. Set all three (Razorpay dashboard →
# test or live) to mount /api/payment/order and the webhook. Left unset, the API
# boots and paid courses show a paywall but cannot be bought (use /api/dev/grant
# locally to unlock for testing).
# RAZORPAY_KEY_ID=          # test: rzp_test_… / live: rzp_live_…
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=  # the secret you set on the Razorpay webhook

# --- Web (static, publishable only) ---
NEXT_PUBLIC_API_URL=       # the Railway API origin
